# Local-only default: start with python run.py or ./start_linux.sh.
SOCFORGE_DB=./data/socforge.db
SOCFORGE_PORT=8080
# For integrations, set a random secret. Ingestion requires X-API-Key when set.
SOCFORGE_API_KEY=
# Optional: paste a published n8n production webhook URL here. Blank = no outbound notifications.
SOCFORGE_N8N_WEBHOOK_URL=
# Demo and all UI write actions are intentionally designed for localhost-only testing.
