#!/usr/bin/env python3
"""Wazuh Integrator adapter (optional). Install on an authorised Wazuh manager.

Expected Wazuh invocation:
    custom-socforge <alert_json_file> <api_key> <hook_url>

Configure URL and key in /var/ossec/etc/ossec.conf. This helper does not
modify endpoints, change firewall rules, or take containment action.
"""
import json
import pathlib
import sys
import urllib.parse
import urllib.request


def main(argv):
    if len(argv) < 4:
        print("usage: custom-socforge <alert-file> <api-key> <webhook-url>", file=sys.stderr)
        return 2
    path = pathlib.Path(argv[1])
    api_key = argv[2]
    url = argv[3]
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        print("invalid SOCForge URL", file=sys.stderr)
        return 2
    try:
        raw = path.read_text(encoding="utf-8")
        alert = json.loads(raw)
        if not isinstance(alert, dict):
            raise ValueError("expected one JSON alert object")
        body = json.dumps(alert).encode("utf-8")
        headers = {"Content-Type": "application/json", "User-Agent": "SOCForge-Wazuh-Adapter/1.0"}
        if api_key:
            headers["X-API-Key"] = api_key
        request = urllib.request.Request(url, data=body, headers=headers, method="POST")
        with urllib.request.urlopen(request, timeout=5) as response:
            if not 200 <= response.status < 300:
                print(f"SOCForge returned HTTP {response.status}", file=sys.stderr)
                return 1
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"SOCForge integration error: {type(exc).__name__}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
